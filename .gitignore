# Unignore specific files
!README.MD
!.gitignore

# Explicitly ignore these (redundant due to * but good for clarity/overrides if I change * later)
config.py
logs/
.arcshots/
.codex-worktrees/
*.log
__diag.py
tests/
docs/
results.md
!AGENTS.md
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/arcvpn-stage/
!.agents/skills/arcvpn-stage/**
!.agents/skills/arcvpn-frontend-qa/
!.agents/skills/arcvpn-frontend-qa/**
!.agents/skills/arcvpn-closeout/
!.agents/skills/arcvpn-closeout/**
.codex/stages/*.local.md
**/__pycache__/
.vscode

# База данных (создаётся автоматически при запуске)
database/vpn_bot.db

# Локальные бэкапы (создаются автоматически планировщиком)
backup/

# Virtual Environment
venv/
env/
.venv/
.env/
env*/
venv*/
.env
.secrets/

debug-vpn-slow-speed.md
ARCHITECTURE_NEXT_CHAT_BRIEF.md
WORKING_NOTES.md
AI_CONTEXT.md

# One-shot local diagnostics may contain temporary infrastructure credentials.
.*_tmp.py
