# ArcVPN: скопируйте значения в окружение systemd или локальный .env.
# Никогда не коммитьте реальные пароли.

# SMTP для одноразовых email-кодов
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=ArcVPN <no-reply@example.com>
SMTP_USE_TLS=true

# WebApp purchase preview. Final billing integration must use the same value server-side.
VITE_EXTRA_LTE_GB_MONTHLY_RUB=2
VITE_REFERRAL_STATS_URL=

# Реквизиты для пользовательского соглашения
LEGAL_OPERATOR_NAME=[УКАЖИТЕ ФИО ИЛИ НАЗВАНИЕ]
LEGAL_OPERATOR_INN=[УКАЖИТЕ ИНН]
LEGAL_OPERATOR_REGISTRATION=[УКАЖИТЕ ОГРНИП/ОГРН]
LEGAL_OPERATOR_ADDRESS=[УКАЖИТЕ АДРЕС]
LEGAL_CONTACT_EMAIL=[УКАЖИТЕ EMAIL]
# Password is configured only on the server; never commit the real value.
ADMIN_CONSOLE_PASSWORD=
