[Unit]
Description=ArcVPN pinned Multitest agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/arcvpn/benchmark_agent.py
TimeoutStartSec=1000
KillMode=control-group
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=256M
TasksMax=64
LimitFSIZE=5242880
